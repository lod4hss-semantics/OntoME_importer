{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod4hss.org/ontome-importer/schemas/namespace-registry-1.0.json",
  "title": "OntoME namespace registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "namespaces"],
  "properties": {
    "format_version": {"const": "1.0"},
    "namespaces": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["uri", "ontome_namespace_id", "status", "source"],
        "properties": {
          "uri": {"type": "string", "format": "uri"},
          "ontome_namespace_id": {"type": "integer", "minimum": 1},
          "status": {"enum": ["active", "deprecated", "forbidden"]},
          "source": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
