{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod4hss.org/ontome-importer/schemas/mapping-profile-7.0.json",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "scope", "rules", "external_references", "external_reference_rules", "editorial_exceptions", "decisions"],
  "properties": {
    "format_version": {"const": "7.0"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["resource_selectors"], "properties": {"resource_selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector"}}}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "external_references": {"type": "array", "items": {"$ref": "#/$defs/external_reference"}},
    "external_reference_rules": {"type": "array", "items": {"$ref": "#/$defs/external_reference_rule"}},
    "editorial_exceptions": {"type": "array", "items": {"$ref": "#/$defs/editorial_exception"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "uri_list": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "selector": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"uri": {"type": "string", "format": "uri"}, "uri_prefix": {"type": "string", "format": "uri"}, "rdf_type": {"type": "string", "format": "uri"}}},
    "text_field": {"type": "object", "additionalProperties": false, "required": ["field", "predicates"], "properties": {"field": {"enum": ["scopeNote", "example", "contextNote", "bibliographicalNote"]}, "predicates": {"$ref": "#/$defs/uri_list"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["field", "predicate"], "properties": {"field": {"enum": ["subClassOf", "equivalentClass", "disjointWith", "subPropertyOf", "equivalentProperty", "inverseOf"]}, "predicate": {"type": "string", "format": "uri"}}},
    "identifier_in_namespace": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source", "strip_prefix"], "properties": {"source": {"const": "uri_suffix"}, "strip_prefix": {"type": "string", "format": "uri"}}}, {"type": "object", "additionalProperties": false, "required": ["source", "predicate"], "properties": {"source": {"const": "literal_predicate"}, "predicate": {"type": "string", "format": "uri"}}}, {"type": "object", "additionalProperties": false, "required": ["source", "pattern"], "properties": {"source": {"const": "regex_capture"}, "pattern": {"type": "string", "minLength": 1}}}]},
    "target": {"type": "object", "additionalProperties": false, "required": ["entity_kind", "identifier_in_namespace", "label_predicates"], "properties": {"entity_kind": {"enum": ["class", "property"]}, "property_kind": {"enum": ["object", "datatype", "rdf"]}, "identifier_in_namespace": {"$ref": "#/$defs/identifier_in_namespace"}, "identifier_in_uri": {"const": "source_uri"}, "label_predicates": {"$ref": "#/$defs/uri_list"}, "text_fields": {"type": "array", "items": {"$ref": "#/$defs/text_field"}}, "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}, "domain_range": {"type": "object", "additionalProperties": false, "required": ["domain_predicate", "range_predicate"], "properties": {"domain_predicate": {"type": "string", "format": "uri"}, "range_predicate": {"type": "string", "format": "uri"}}}}, "allOf": [{"if": {"properties": {"entity_kind": {"const": "property"}}}, "then": {"required": ["property_kind", "domain_range"]}}, {"if": {"properties": {"entity_kind": {"const": "class"}}}, "then": {"not": {"anyOf": [{"required": ["property_kind"]}, {"required": ["domain_range"]}]}}}]},
    "rule": {"type": "object", "additionalProperties": false, "required": ["id", "selector", "action"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "selector": {"$ref": "#/$defs/selector"}, "action": {"enum": ["map", "configure", "exclude"]}, "target": {"$ref": "#/$defs/target"}, "reason": {"type": "string", "minLength": 1}, "decision_needed": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"action": {"const": "map"}}}, "then": {"required": ["target"]}}, {"if": {"properties": {"action": {"const": "configure"}}}, "then": {"required": ["decision_needed"]}}, {"if": {"properties": {"action": {"const": "exclude"}}}, "then": {"required": ["reason"]}}]},
    "external_reference": {"type": "object", "additionalProperties": false, "required": ["uri", "reference_namespace", "identifier"], "properties": {"uri": {"type": "string", "format": "uri"}, "reference_namespace": {"type": "integer", "minimum": 1}, "identifier": {"type": "string", "pattern": "^\\S+$"}}},
    "external_reference_rule": {"type": "object", "additionalProperties": false, "required": ["id", "uri_prefix", "reference_namespace", "identifier_extraction"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "uri_prefix": {"type": "string", "format": "uri"}, "reference_namespace": {"type": "integer", "minimum": 1}, "identifier_extraction": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "uri_suffix"}}}, {"type": "object", "additionalProperties": false, "required": ["source", "pattern"], "properties": {"source": {"const": "regex_capture"}, "pattern": {"type": "string", "minLength": 1}}}]}}},
    "editorial_exception": {"type": "object", "additionalProperties": false, "required": ["id", "resource_uri", "field", "reference_uri", "status", "rationale", "approved_by", "approved_at", "decision_reference"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "resource_uri": {"type": "string", "format": "uri"}, "field": {"enum": ["hasDomain", "hasRange"]}, "reference_uri": {"type": "string", "format": "uri"}, "status": {"enum": ["proposed", "approved", "rejected"]}, "rationale": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date"}, "decision_reference": {"type": "string", "minLength": 1}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "resource_uri", "construct", "action", "status", "rationale", "approved_by", "approved_at", "decision_reference"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "resource_uri": {"type": "string", "format": "uri"}, "construct": {"type": "string", "minLength": 1}, "action": {"enum": ["map", "transform", "reference", "exclude", "editorial_exception"]}, "status": {"enum": ["proposed", "approved", "rejected"]}, "rationale": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date"}, "decision_reference": {"type": "string", "minLength": 1}, "mapping_rule": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "exception_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}}}
  }
}
